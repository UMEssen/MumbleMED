# --- LLM (OpenAI-compatible Chat Completions API) ---
LLM_NAME="openai-compatible-model-id"
LLM_ENDPOINT="http://127.0.0.1:8000/v1"
LLM_API_KEY=""
LOCAL_LLM="false"

# --- llm mode: output paths ---
LLM_DATASET_PATH=""
LLM_CSV_PATH=""

# --- real mode: output base path ---
REAL_DATASET_PATH=""

# --- Shared: TTS ---
SPEAKER_VOICES_PATH=""
TTS_LANGUAGE="de"
USE_DEFAULT_TTS_VOICE="false"
WORDS_PER_MINUTE="80"
CHUNKING_MODE="sentence-divide"
MAX_TTS_WORDS=""
TTS_LENGTH_POLICY="rechunk"
MAX_AUDIO_DURATION_SECONDS="30.0"
GPU_ID=""

# German TTS (Kartoffelbox patch). Not needed for --tts-language en.
MODEL_REPO="SebastianBodza/Kartoffelbox-v0.1"
T3_CHECKPOINT="t3_cfg.safetensors"
HF_TOKEN=""

# --- llm mode: coding systems (CSV files: display, code columns) ---
CODING_SYSTEMS_PATH=""
CODING_SYSTEMS="ICD,OPS,RADLEX"
CODING_SYSTEM_FILES=""

# --- Defaults ---
NUM_SYNTHETIC_DOCS="5000"
NUM_REAL_DOCUMENTS="2500"
NUM_WORKERS="4"
